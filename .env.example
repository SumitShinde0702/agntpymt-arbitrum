# ── App (single root .env — loaded by server + client via Vite envDir) ──
NODE_ENV=development
PORT=3001

# Database — PostgreSQL (local Docker or Cloud SQL)
# Local: docker compose -f deploy/docker/docker-compose.postgres.yml up -d
DATABASE_URL=postgresql://agntpymt:agntpymt@localhost:5432/agntpymt

# GCP — Hermes profile artifacts (SOUL, skills, config). Omit for local disk only.
# GCS_PROFILE_BUCKET=your-project-agntpymt-profiles
# GCS_PROFILE_PREFIX=hermes
# AGNTPYMT_PUBLIC_URL=https://your-service.run.app

# Client (Vite exposes VITE_* to browser)
VITE_API_URL=http://localhost:3001
VITE_APP_NAME=AgntPymt MVP Demo
# Internal only — show Sellers nav for ERC-8004 vendor minting (not client-facing)
# VITE_SHOW_SELLER_ADMIN=true

# Clerk — set both keys (publishable can be shared via VITE_* name)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Hermes gateway (optional) — off by default; runs use the built-in OpenAI negotiation runner
HERMES_ENABLED=false
# Must match API_SERVER_KEY in ~/.hermes/.env
HERMES_API_URL=http://localhost:8642
HERMES_API_KEY=change-me-local-dev

# MCP service key (must match AGNTPYMT_MCP_KEY in ~/.hermes/config.yaml mcp env)
AGNTPYMT_MCP_KEY=dev-mcp-key

# LLM (negotiation dialogue in Agent Console)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Payments — x402 EIP-3009 USDC on Arbitrum Sepolia (eip155:421614)
# The default x402.org facilitator does not support Arbitrum; PayAI does (no signup).
SIMULATE_PAYMENTS=true
DEMO_TRANSACTION_FEE_USD=0.01
EVM_PAY_TO_ADDRESS=
# Must be a different wallet than org treasury / NFT owner (ERC-8004 blocks self-feedback)
FACILITATOR_URL=https://facilitator.payai.network
# ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# On-chain governance — AgentSpendPolicy (contracts/). Leave blank to run with off-chain policy only.
# Works with SIMULATE_PAYMENTS=true too: authorizations/approvals/settlement records still land on Arbitrum.
SPEND_POLICY_ADDRESS=
# Policy admin + operator key; needs a little Arbitrum Sepolia ETH for gas
SPEND_POLICY_ADMIN_PRIVATE_KEY=
SPEND_POLICY_DEFAULT_DAILY_USD=100

# Seller payment wallet private key — optional; signs seller wallet-link step only
# VENDOR_WALLET_PRIVATE_KEY=0x...

# Public URL for MCP entry in ERC-8004 registration (optional locally)
# AGNTPYMT_PUBLIC_URL=https://your-vm.example.com
